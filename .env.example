# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Department folder bindings ───────────────────────────────────────────────
# One entry per department. Key format:
#   DEPT_FOLDER_{open_department_id with hyphens replaced by underscores}
#
# These are written automatically via the bind-folder card flow.
# You can also set them manually for dev/testing.
#
# Example (replace with your actual open_department_id and folder token):
# DEPT_FOLDER_od_c5a40c187b6a50163de9c30b4dbe84b4=fldcnABCDEFGHIJKL

# ── Admin / manager access ───────────────────────────────────────────────────
# Comma-separated open_ids of users who get the admin view.
# Find open_ids via the /whoami command in Feishu.
# ADMIN_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,ou_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
